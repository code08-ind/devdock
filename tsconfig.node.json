{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.js",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    // DOM-free renderer logic that unit tests import directly.
    "src/renderer/features/palette/commands.ts",
    "tests/unit/**/*"
  ]
}
